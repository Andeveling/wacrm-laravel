{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "laravel/react-starter-kit",
  "type": "project",
  "description": "The skeleton application for the Laravel framework.",
  "keywords": ["laravel", "framework"],
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel-lang/lang": "^15.0",
    "laravel/ai": "^0.9.1",
    "laravel/fortify": "^1.37.2",
    "laravel/framework": "^13.17",
    "laravel/mcp": "^0.8.2",
    "laravel/reverb": "^1.10",
    "laravel/tinker": "^3.0",
    "laravel/wayfinder": "^0.1.14"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9",
    "laravel-lang/publisher": "^16.8",
    "laravel/boost": "^2.4",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.27",
    "laravel/sail": "^1.53",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9.3",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-browser": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "composer install",
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate",
      "@php artisan migrate --force",
      "pnpm install",
      "pnpm build"
    ],
    "dev": ["Composer\\Config::disableProcessTimeout", "@php artisan dev"],
    "lint": ["pint --parallel"],
    "lint:no-inline-fqcn": ["@php tools/lint/no-inline-fqcn.php"],
    "lint:adr-layers": ["@php tools/lint/adr-layers.php"],
    "lint:test-layout": ["@php tools/lint/test-layout.php"],
    "lint:check": [
      "pint --parallel --test",
      "@lint:no-inline-fqcn",
      "@lint:adr-layers",
      "@lint:test-layout"
    ],
    "ci:check": [
      "Composer\\Config::disableProcessTimeout",
      "pnpm lint:check",
      "pnpm format:check",
      "pnpm types:check",
      "pnpm test",
      "pnpm check:quality-exceptions",
      "pnpm check:duplication",
      "@test"
    ],
    "types:check": ["phpstan analyse --memory-limit=1G"],
    "test": [
      "@php artisan config:clear --ansi",
      "@lint:check",
      "@types:check",
      "@php artisan test --exclude-testsuite=Browser"
    ],
    "test:browser": ["@php artisan test --testsuite=Browser"],
    "hooks:install": [
      "@php -r \"is_dir('.git') and is_dir('node_modules') and passthru('pnpm exec lefthook install');\""
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@hooks:install"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
