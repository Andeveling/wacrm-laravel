includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    # Existing Pest diagnostics are recorded while the suite is adopted. New
    # diagnostics still fail `types:check`; application analysis is unchanged.
    - phpstan-tests-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/
        - tests/Fixtures/

    level: 7

    # PHPDoc types (e.g. GuardHelpers' $user) are hints, not certainties —
    # without this, ApiKeyGuard's `instanceof ApiKey` check is flagged as
    # always-false because larastan maps Authenticatable to User.
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        -
            message: '#return type with generic class Illuminate\\Database\\Eloquent\\Builder does not specify its types#'
            paths:
                - app/Mcp/
        -
            message: '#has parameter \$query with generic class Illuminate\\Database\\Eloquent\\Builder#'
            paths:
                - app/Mcp/
        -
            message: '#has parameter \$paginator with generic interface#'
            paths:
                - app/Mcp/
