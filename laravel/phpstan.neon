includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/Fixtures/

    level: 7

    # PHPDoc types (e.g. GuardHelpers' $user) are hints, not certainties —
    # without this, ApiKeyGuard's `instanceof ApiKey` check is flagged as
    # always-false because larastan maps Authenticatable to User.
    treatPhpDocTypesAsCertain: false
