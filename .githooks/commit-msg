#!/usr/bin/env bash
# Enforces Conventional Commits on the subject line. The repo already follows
# it (feat/fix/chore/docs/refactor/test); this stops the drift.
#
# Merge, revert, fixup and squash subjects are generated by git itself and pass
# through untouched.

set -uo pipefail

subject=$(sed -n '/^[^#]/{p;q;}' "$1")

case "$subject" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ * | Reapply\ *) exit 0 ;;
esac

if [[ $subject =~ ^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?:\ .+ ]]; then
  [ ${#subject} -le 72 ] && exit 0
  printf '\n\033[1;31m✗ Commit subject is %s chars; keep it under 72.\033[0m\n\n  %s\n\n' \
    "${#subject}" "$subject"
  exit 1
fi

printf '\n\033[1;31m✗ Commit subject is not a Conventional Commit.\033[0m\n\n' >&2
printf '  got:      %s\n\n' "$subject" >&2
printf '  expected: <type>[(scope)][!]: <description>\n' >&2
printf '  types:    build chore ci docs feat fix perf refactor revert style test\n' >&2
printf '  example:  fix(auth): reject expired passkey challenges\n\n' >&2
printf '\033[2mSubjects in English, imperative mood. Bypass with --no-verify.\033[0m\n\n' >&2
exit 1
