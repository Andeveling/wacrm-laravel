# Reason: Pest static analysis starts with the diagnostics already present in
# tests/; new diagnostics still fail the quality gate.
# Tracking: #127 will move these entries to the central quality allowlist.
# Expires: when #127 is merged.
parameters:
	ignoreErrors:
