{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!original-wacrm"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf",
    "useEditorconfig": true,
    "includes": [
      "**",
      "!resources/js/components/ui/*",
      "!resources/views/mail/*"
    ]
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 120,
            "skipBlankLines": true
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noReactForwardRef": "error",
        "noLeakedRender": "warn",
        "noImportCycles": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noNestedComponentDefinitions": "error",
        "noReactPropAssignments": "error",
        "useUniqueElementIds": "warn"
      },
      "style": {
        "useComponentExportOnlyModules": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300,
            "skipBlankLines": true
          }
        }
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "off",
        "useButtonType": "off",
        "useAriaPropsSupportedByRole": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noBlankTarget": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      }
    },
    "includes": [
      "**",
      "!vendor",
      "!node_modules",
      "!public",
      "!public/favicon.svg",
      "!bootstrap/ssr",
      "!tailwind.config.js",
      "!vite.config.mts",
      "!resources/js/actions/**",
      "!resources/js/components/ui/*",
      "!resources/js/routes/**",
      "!resources/js/wayfinder/**"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "attributePosition": "auto"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.yml", "**/*.yaml"],
      "formatter": {
        "indentWidth": 2
      }
    },
    {
      "includes": [
        "resources/js/modules/contacts/**",
        "resources/js/pages/contacts.tsx",
        "resources/js/modules/whatsapp/**",
        "resources/js/pages/settings/whatsapp.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "error",
            "noLeakedRender": "error"
          },
          "correctness": {
            "useExhaustiveDependencies": "error",
            "useUniqueElementIds": "error"
          },
          "a11y": {
            "noSvgWithoutTitle": "error",
            "useAriaPropsSupportedByRole": "error",
            "useButtonType": "error",
            "useSemanticElements": "error"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "includes": ["**", "!resources/js/components/ui/*"],
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
